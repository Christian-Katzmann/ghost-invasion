      "$schema": "ghost-invasion/journey@1",
      "id": "double-click-save",
      "name": "EDIT ME: project creation duplicate-submit check",
      "goal": "Impatient user double-clicks Create; app must not create two projects.",
      "appliesToPersonas": [
        "chaotic-user"
      ],
      "invariantsTested": [
        "mutation.idempotent-create"
      ],
      "pristineRequired": true,
      "anchors": {
        "routes": [
          "/projects/new"
        ],
        "mutations": [
          "core.projects.create"
        ],
        "surfaceHash": "sha256:projectly-step-1-1"
      },
      "idealPath": [
        "goto:/projects/new",
        "fill:name=Launch plan",
        "clickRole:button:Create"
      ],
      "steps": [
        {
          "type": "goto",
          "url": "/projects/new"
        },
        {
          "type": "fill",
          "selector": "role=textbox[name=/name/i]",
          "value": "Launch plan"
        },
        {
          "type": "dbSnapshot",
          "id": "before"
        },
        {
          "type": "doubleSubmit",
          "role": "button",
          "name": "Create",
          "gapMs": 80,
          "cause": "ghost-injected"
        },
        {
          "type": "wait",
          "ms": 1500
        },
        {
          "type": "dbSnapshot",
          "id": "after"
        }
      ],
      "success": [
        {
          "type": "expectDbDiff",
          "table": "projects",
          "where": {
            "name": "Launch plan"
          },
          "expectInserted": 1
        }
      ],
      "abandon": [
        {
          "type": "expectDbDiff",
          "table": "projects",
          "where": {
            "name": "Launch plan"
          },
          "expectInserted": 1,
          "negate": true,
          "as": "failure",
          "label": "Duplicate project created on double-click"
        }
      ]
    }
  ],
  "surfaceHash": "sha256:projectly-step-1-1",
